  "scripts": {
    "gen:exports": "node scripts/gen-exports.mjs",
    "gen:exports:check": "node scripts/gen-exports.mjs --check",
    "build:registry": "node scripts/build-registry.mjs",
    "test:cli": "node scripts/smoke-test-cli.mjs",
    "build": "node scripts/gen-exports.mjs && node scripts/build-registry.mjs && bob build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepare": "node scripts/gen-exports.mjs && node scripts/build-registry.mjs && bob build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.73.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.35.3",
    "react-native-safe-area-context": "~5.8.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.9.3"
  },
  "keywords": [
    "react-native",
    "ui",
    "components",
    "atomic-design"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
