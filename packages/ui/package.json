{
  "name": "orn-ui",
  "version": "0.1.0",
  "description": "Fast, tree-shakeable, atomic-design component library for React Native. Zero runtime dependencies.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "sideEffects": false,
  "bin": {
    "orn-ui": "./bin/orn-ui.mjs"
  },
  "files": [
    "src",
    "lib",
    "bin",
    "registry",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/module/index.js"
    },
    "./title": {
      "types": "./lib/typescript/atoms/Text.d.ts",
