{
  "name": "example",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "sdk": "node scripts/use-sdk.mjs",
    "go": "expo start --go",
    "gen:maestro": "node scripts/gen-maestro-flows.mjs",
    "gen:maestro:check": "node scripts/gen-maestro-flows.mjs --check",
    "gen:maestro:demos": "node scripts/gen-maestro-demos.mjs",
    "gen:maestro:demos:check": "node scripts/gen-maestro-demos.mjs --check",
    "e2e:ios:build": "expo run:ios --configuration Release --no-install --no-bundler",
    "e2e:ios:smoke": "maestro test --include-tags smoke .maestro",
    "e2e:ios:behavior": "maestro test --include-tags behavior .maestro",
    "e2e:ios": "maestro test .maestro"
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "orn-ui": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~5.9.3"
  }
}
